#!/usr/bin/env bash
# Stub `gh` for merge-policy.test.ts. One simulated PR per scenario, set by env:
# FILES ("status:path" list; "renamed:old>new"), DOOR, CHANGE, CHECKS (JSON),
# THREADS (JSON), REVIEWERS (logins; "login@oid" to review an older commit;
# "login:PENDING" for a pending review), COMMENTS (JSON list of issue comment
# bodies), COMMITS (shas on the PR branch; default HEAD), DRAFT, BASE, HEAD,
# PRS (JSON list of the repo's recent PRs as {checks:[check runs],
# contexts:[status contexts],logins:[review and comment logins]};
# "fail" makes that one lookup fail; default: three PRs on which every reviewer
# the test config names has appeared), FAIL (any value makes every gh call fail).
[ -n "${FAIL:-}" ] && { echo "stub gh: failing on purpose" >&2; exit 1; }
DEF='[{"name":"validate","conclusion":"SUCCESS"}]'; CHECKS=${CHECKS:-$DEF}
DEFPRS='[{"checks":["validate","Cursor Bugbot"],"logins":["cursor[bot]","coderabbitai"]},{"checks":["validate"],"logins":["devin-ai-integration[bot]"]},{"checks":["validate"],"logins":[]}]'
PRS=${PRS:-$DEFPRS}
HEAD=${HEAD:-abc1234}
# A `case` inside `$( )` inside a case arm trips bash's parser, so build the
# review list in a function.
reviews() {
  for r in $REVIEWERS; do
    login=${r%%[@:]*}; oid=$HEAD; state=COMMENTED
    case "$r" in
      (*@*) oid=${r#*@} ;;
      (*:*) state=${r#*:} ;;
    esac
    printf '{"author":{"login":"%s"},"state":"%s","commit":{"oid":"%s"}},' "$login" "$state" "$oid"
  done
}
case "$*" in
  "repo view"*) echo "dom-kelly/demo" ;;
  "auth token"*) echo "gho_stub" ;;
  "api graphql"*"pullRequests("*) [ "$PRS" = fail ] && { echo "stub gh: presence lookup failing on purpose" >&2; exit 1; }
      jq -nc --argjson p "$PRS" '{data:{repository:{pullRequests:{nodes:[$p | to_entries[] | {number:(.key+1), reviews:{nodes:[.value.logins[]? | {author:{login:.}}]}, comments:{nodes:[]}, commits:{nodes:[{commit:{statusCheckRollup:{contexts:{nodes:[(.value.checks[]? | {name:.}), (.value.contexts[]? | {context:.})]}}}}]}}]}}}}' ;;
  *"--json number"*) echo 7 ;;
  "pr view"*) jq -n --arg b "## Intent
**Door:** \`${DOOR:-two-way}\`
**Change:** \`${CHANGE-composes}\`" --argjson c "$CHECKS" --arg base "${BASE:-main}" --arg head "$HEAD" --argjson d "${DRAFT:-false}" \
      '{isDraft:$d,baseRefName:$base,headRefOid:$head,body:$b,statusCheckRollup:$c}' ;;
  "api --paginate"*"/issues/"*"/comments"*) jq -c '.[] | {body: .}' <<<"${COMMENTS:-[]}" ;;
  "api --paginate"*"/pulls/"*"/commits"*) for c in ${COMMITS:-$HEAD}; do echo "$c"; done ;;
  "api --paginate"*"/files"*) for f in $FILES; do st=${f%%:*} p=${f#*:}
      if [ "$st" = renamed ]; then jq -nc --arg a "${p#*>}" --arg b "${p%%>*}" '{status:"renamed",filename:$a,previous_filename:$b}'
      else jq -nc --arg s "$st" --arg p "$p" '{status:$s,filename:$p}'; fi; done ;;
  "api graphql"*) revs=$(reviews)
      jq -n --argjson t "${THREADS:-[]}" --argjson r "[${revs%,}]" '{data:{repository:{pullRequest:{reviewThreads:{nodes:$t},reviews:{nodes:$r}}}}}' ;;
  *) echo "stub gh: unhandled $*" >&2; exit 1 ;;
esac
